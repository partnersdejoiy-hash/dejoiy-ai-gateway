{
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "prom-client": "^15.1.3",
    "uuid": "^11.1.0"
  },
  "description": "DEJOIY AI Gateway \u2014 unified model router with automatic failover across open-source and free-tier inference engines",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "name": "dejoiy-ai-gateway",
  "scripts": {
    "build": "tsc && mkdir -p dist/db dist/dashboard && cp src/db/schema.sql dist/db/ && cp src/dashboard/index.html dist/dashboard/ 2>/dev/null || true",
    "dev": "ts-node src/index.ts",
    "lint": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit --runInBand"
  },
  "type": "commonjs",
  "version": "1.0.0"
}