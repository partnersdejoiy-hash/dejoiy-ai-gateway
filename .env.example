# =====================================================================
# DEJOIY AI Gateway — environment configuration
# Copy to .env and fill in. NEVER commit .env with real keys.
# =====================================================================

# ---- Gateway ----
PORT=8000
HOST=0.0.0.0
REQUIRE_AUTH=false
# Comma-separated API keys bots must present (Authorization: Bearer <key> or x-api-key).
# Only enforced when REQUIRE_AUTH=true.
GATEWAY_API_KEYS=
RATE_LIMIT_PER_MINUTE=600
REQUEST_TIMEOUT_MS=60000
DB_PATH=./data/gateway.db

# ---- Health / circuit breaker / queue tuning ----
HEALTH_CHECK_INTERVAL_MS=30000
HEALTH_CHECK_TIMEOUT_MS=8000
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_MS=60000
CB_SUCCESS_THRESHOLD=2
MAX_QUEUE_SIZE=500
QUEUE_TIMEOUT_MS=120000
MAX_CONCURRENCY=64

# ---- Logical models (optional JSON override) ----
# LOGICAL_MODELS_JSON=[{"logicalModel":"kaali-fast","providers":[{"provider":"groq","model":"llama-3.1-8b-instant"}]}]

# =====================================================================
# Providers — set <PREFIX>_ENABLED=true to activate.
# =====================================================================

# ---- vLLM (self-hosted) ----
VLLM_ENABLED=false
VLLM_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen3-8B
VLLM_TIMEOUT_MS=30000
VLLM_WEIGHT=1

# ---- llama.cpp server ----
LLAMACPP_ENABLED=false
LLAMACPP_URL=http://localhost:8080/v1
LLAMACPP_MODEL=default
LLAMACPP_TIMEOUT_MS=30000
LLAMACPP_WEIGHT=1

# ---- LocalAI ----
LOCALAI_ENABLED=false
LOCALAI_URL=http://localhost:8080/v1
LOCALAI_API_KEY=
LOCALAI_MODEL=ggml-model
LOCALAI_TIMEOUT_MS=30000
LOCALAI_WEIGHT=1

# ---- SGLang ----
SGLANG_ENABLED=false
SGLANG_URL=http://localhost:30000/v1
SGLANG_MODEL=Qwen3-8B
SGLANG_TIMEOUT_MS=30000
SGLANG_WEIGHT=1

# ---- Hugging Face TGI ----
TGI_ENABLED=false
TGI_URL=http://localhost:8080/v1
TGI_MODEL=Qwen3-8B
TGI_TIMEOUT_MS=30000
TGI_WEIGHT=1

# ---- KoboldCpp ----
KOBOLDCPP_ENABLED=false
KOBOLDCPP_URL=http://localhost:5001/v1
KOBOLDCPP_API_KEY=
KOBOLDCPP_MODEL=koboldcpp
KOBOLDCPP_TIMEOUT_MS=30000
KOBOLDCPP_WEIGHT=1

# ---- Space Bunny ----
SPACE_BUNNY_ENABLED=false
SPACE_BUNNY_URL=
SPACE_BUNNY_API_KEY=
SPACE_BUNNY_MODEL=space-bunny-default
SPACE_BUNNY_TIMEOUT_MS=30000
SPACE_BUNNY_WEIGHT=1

# ---- Google Gemini (free tier) ----
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_WEIGHT=1

# ---- Groq (free tier) ----
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_MS=30000
GROQ_WEIGHT=1

# ---- OpenRouter (free models) ----
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-32b:free
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_WEIGHT=1

# ---- Cerebras (free tier) ----
CEREBRAS_ENABLED=false
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b
CEREBRAS_TIMEOUT_MS=30000
CEREBRAS_WEIGHT=1

# ---- Pollinations (free, keyless — no signup needed) ----
# Enabled by default: always-on last-resort failover.
POLLINATIONS_ENABLED=true
POLLINATIONS_URL=https://text.pollinations.ai/openai
POLLINATIONS_MODEL=openai
POLLINATIONS_TIMEOUT_MS=30000
POLLINATIONS_WEIGHT=1
